# Server-side settings. Copy to .env; never put real keys in this tracked example.
RESEARCH_DATA_DIR=./data
RESEARCH_MAX_UPLOAD_MB=50
RESEARCH_MAX_PAGES=500
RESEARCH_PARSE_TIMEOUT=300
# Local model workers stay warm across consecutive jobs, then exit after these idle TTLs.
RESEARCH_DOCLING_IDLE_SECONDS=120
# Optional: predownloaded local Docling artifacts directory.
# DOCLING_ARTIFACTS_PATH=
API_BASE=http://127.0.0.1:8000
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=90
DEEPSEEK_MAX_OUTPUT_TOKENS=2048
RESEARCH_CONTEXT_BYTES=50000
RESEARCH_INDEX_TIMEOUT=600
RESEARCH_EMBEDDING_IDLE_SECONDS=300
# 1 = a successful parse queues the dense + BM25 index build automatically.
RESEARCH_AUTO_INDEX=1
RESEARCH_EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
# Retrieval funnel: one library over the selected papers, then fusion and rerank.
RESEARCH_CANDIDATES=60
RESEARCH_RERANK_TOP_N=10
RESEARCH_RERANKER_IDLE_SECONDS=300
# Counted model calls per turn (grade ① + grade ② + generation); translation is free.
RESEARCH_AGENT_MAX_CALLS=3
# In-process index cache: byte budget, entry count and idle TTL in seconds.
RESEARCH_INDEX_CACHE_MB=300
RESEARCH_INDEX_CACHE_ENTRIES=8
RESEARCH_INDEX_CACHE_TTL=1800

# Optional Tavily search fallback (server only; restart after changing)
TAVILY_API_KEY=
